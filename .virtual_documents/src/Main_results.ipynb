def calculate_radius_of_gyration(belief_vectors):
    
    belief_matrix = np.vstack(belief_vectors)  # Shape: (N, D) where N is the number of vectors, D is the dimension
    center_of_mass = np.mean(belief_matrix, axis=0)  # Shape: (D,)
    squared_distances = np.sum((belief_matrix - center_of_mass)**2, axis=1)  # Shape: (N,)
    mean_squared_distance = np.mean(squared_distances)
    radius_of_gyration = np.sqrt(mean_squared_distance)

    return radius_of_gyration

