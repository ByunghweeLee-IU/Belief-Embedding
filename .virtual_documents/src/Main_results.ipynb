df_ = pd.read_pickle(f'../dataset-robust/full_data/downstream_results/downstream_task_result_idx0.p')
df_.head()


from scipy.stats import pearsonr



category2count = {}
category2f1 = {}
category2d_rel = {}

for cat, dat in df_.groupby('category'):
    if cat in filtered_cat_list:
        category2count[cat] = dat['cat_count_train'].iloc[0]
        category2f1[cat] = f1_score(dat['position'], dat['predicted_outcome'], labels=['Pro','Con'], average='macro')
        category2d_rel[cat] = dat['d_rel'].mean()


cat_sorted = []
f1_sorted= []
cat_counts = []
d_rel_sorted = []

for c in sorted(category2f1, key=category2f1.get, reverse=True):
    cat_sorted.append(c)
    f1_sorted.append(category2f1[c])
    cat_counts.append(category2count[c])
    d_rel_sorted.append(category2d_rel[c])



#For full data
fig, ax = plt.subplots(figsize=(4.7,3.8), dpi=150)

sns.regplot(x=d_rel_sorted, y=f1_sorted, ax=ax, scatter_kws={'s':7})

for text_idx, text in enumerate(cat_sorted):
    ax.text(x=d_rel_sorted[text_idx], y=f1_sorted[text_idx], s=cat_sorted[text_idx], fontsize=6)

label_fontsize = 15
ax.set_xlabel(r'Mean $d^{*}$', fontsize=label_fontsize)
ax.set_ylabel('F1-score', fontsize=label_fontsize)

plt.xticks(fontsize=12)
plt.tight_layout()

plt.show()


print(rf'Pearson correlation: {pearsonr(d_rel_sorted, f1_sorted)[0]:.3f} (P={pearsonr(d_rel_sorted, f1_sorted)[1]:.3f})')
